PORT=3000
# Gemini key(s) for transcription + stance classification. Without a key the
# server still runs; replies are labelled UNRESOLVED and transcripts are a stub.
GEMINI_API_KEY=
# Comma-separated list also works:
# GEMINI_API_KEYS=key1,key2

# TEMPORARY until accounts exist: lets requests say who they are with an
# "X-Dev-User: <username>" header. Automatically OFF when NODE_ENV=production.
ALLOW_DEV_USER=1

# Accounts
# JWT_SECRET=                # REQUIRED in production: a random string of 32+ characters. In development one is created for you
# MIN_AGE=18                 # youngest allowed age at sign-up
# DEFAULT_COUNTRY_CODE=+91   # prefix for bare 10-digit phone numbers

# Optional overrides (defaults shown)
# DB_FILE=./data/forest-app.db
# DB_SAVE_DELAY_MS=250   # coalesce database writes; 0 = write after every change
# UPLOADS_DIR=./uploads

# ACCESS_LOG=1              # one line per request (on by default in production, off in development; 0 turns it off)

# Safety (all optional)
# RATE_LIMIT=0               # turn request rate limits off (they are on by default)
# TRUST_PROXY=1              # set when running behind nginx so limits use the real client address
# CORS_ORIGINS=https://x.app # production only: web origins allowed to call the API (mobile needs none)
# ALLOW_LEGACY_UPLOAD=1      # keep the old unauthenticated /api/videos/upload (dev only; off in production)
# JOB_TIMEOUT_MS=180000      # give up on a stuck ffmpeg/Gemini step after this long and mark the video FAILED

# Show the website this app's latest numbers + debate graph (one way: app -> website; off unless both are set).
# Anonymous: counts and post structure only, no names/phones/e-mails/media. Use the same token as APP_SYNC_TOKEN on the website.
# WEBSITE_SYNC_URL=https://forestapp.in/api/app-sync
# WEBSITE_SYNC_TOKEN=a-long-random-string
# WEBSITE_SYNC_TITLES=1      # also send post titles (off by default; the site is public)
# WEBSITE_SYNC_SECONDS=60    # how often to check for changes

# How new people prove they own what they sign up with. Default is a 6-digit code sent by e-mail (free).
# SIGNUP_CHANNEL=email       # email | phone. Only the chosen one is switched on; the other's routes answer 404
# MAIL_PROVIDER=console      # console prints the code in this window (development; refused in production) | smtp (real e-mail)
# For smtp, use any service's SMTP login: Brevo, Resend, Amazon SES, Gmail with an app password. See src/auth/mailers.js.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587              # 587 (STARTTLS) or 465 (TLS)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="FOREST <noreply@forestapp.in>"   # the domain needs SPF + DKIM set up at the service, or codes land in spam
# SIGNUP_EMAIL_DOMAINS=      # optional: only these domains may sign up, e.g. thapar.edu for a campus pilot
# SIGNUP_BLOCKED_EMAIL_DOMAINS=   # optional: more throw-away domains to refuse (a built-in list already exists)

# Public pages (a shared debate, an invite, /terms, /privacy). PUBLIC_BASE_URL is the address people outside the app can reach this server on.
# PUBLIC_BASE_URL=https://api.forestapp.in
# PLAY_STORE_URL=            # where the public pages send people to get the app (shown only when set)
# PROMPT_UTC_OFFSET_MIN=330  # the daily question changes at midnight in this time zone (330 = India)

# "Continue with Google": the OAuth client id of type "Web application" from Google Cloud (APIs & Services > Credentials). Leave unset to hide the button.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com

# Sign-up by SMS instead (SIGNUP_CHANNEL=phone; costs money and in India needs DLT registration). msg91 is a PLACEHOLDER:
# untested against the live service. Needs a DLT-registered sender + approved OTP template (with the ##OTP## variable).
# OTP_PROVIDER=msg91
# MSG91_AUTHKEY=
# MSG91_TEMPLATE_ID=

# Caps on sign-up codes, for either channel (the mail service has a daily allowance; an SMS is paid)
# OTP_DAILY_BUDGET=250       # most codes sent per day in total (default 250 for e-mail, 500 for SMS); sign-up pauses for the day when spent
# OTP_PER_IP_PER_DAY=20      # most codes one address may request per day

# Moderation (demo level, see docs/LAST_STAGE_POLISH.md)
# MODERATION_TOKEN=a-long-random-string   # turns on the page at /admin (type this token in); unset = 404
# MODERATION_BLOCKLIST=word1,word2        # a post whose transcript/text contains one is hidden automatically; empty = off
# GRIEVANCE_OFFICER_NAME=                 # REQUIRED before real users: the named person for complaints (shown at /api/legal/contact)
# GRIEVANCE_OFFICER_EMAIL=

# Editor posts are rendered with the ffmpeg that comes with `npm install` (ffmpeg-static). To use a different one:
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe

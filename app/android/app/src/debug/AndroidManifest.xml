<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG BUILDS ONLY: allow plain http:// so the app can talk to the local
         backend (app/backend) at http://10.0.2.2:3000 or your PC's Wi-Fi address.
         Release builds use src/main, which does not set this, so they stay https-only. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>

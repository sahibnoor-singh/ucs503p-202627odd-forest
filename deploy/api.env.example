# The server's settings on the real machine. Copy to deploy/api.env (git-ignored: it holds secrets) and fill in every line.
# Check it before the first start:  docker compose run --rm api node scripts/preflight.js
# What each setting means: app/backend/.env.example and docs/DEPLOY.md.

NODE_ENV=production

# Make each of these yourself:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
MODERATION_TOKEN=

# The https address of this server (the same name as DOMAIN in deploy/.env). Shared links and invite links are built from it.
PUBLIC_BASE_URL=https://api.example.com

# Sign-up codes by e-mail. Brevo: smtp-relay.brevo.com / 587. Resend: smtp.resend.com / 465. Amazon SES: email-smtp.ap-south-1.amazonaws.com / 587.
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FOREST <noreply@example.com>"
# A little under your mail plan's daily allowance (Brevo free is about 300 a day).
OTP_DAILY_BUDGET=250

# The AI that transcribes and labels videos. Without it videos are stored but not analysed.
GEMINI_API_KEY=

# Optional, switch on when ready
GOOGLE_CLIENT_IDS=
MODERATION_BLOCKLIST=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
PLAY_STORE_URL=

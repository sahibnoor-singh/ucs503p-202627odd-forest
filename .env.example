# ==============================================================
# FOREST (UCS-503 Software Engineering Course Project)
# Root Environment Configuration Template
# ==============================================================

# Server Port
PORT=3000

# Google Gemini API Key for Automated Transcription and Stance Classification
# (If unset, server runs in offline stub mode with neutral stances)
GEMINI_API_KEY=

# Authentication & Security
# Generate a secure 32+ character string for production deployment
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# Development Flags
ALLOW_DEV_USER=1

# Optional Custom Database & Upload Paths (defaults to app/backend/data & app/backend/uploads)
# DB_FILE=./data/forest-app.db
# UPLOADS_DIR=./uploads

# Authentication Channel (email | phone)
SIGNUP_CHANNEL=email
MAIL_PROVIDER=console

# Optional Google OAuth Client ID for Google Sign-in
# GOOGLE_CLIENT_IDS=

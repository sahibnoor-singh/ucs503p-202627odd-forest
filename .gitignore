# ==============================================================
# FOREST — Root .gitignore
# ==============================================================

# OS & Environment
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.p12

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# Flutter & Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/.gradle/
app/android/local.properties
app/ios/Flutter/ephemeral/
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/ios/Runner/GeneratedPluginRegistrant.*

# SQLite & Runtime Databases
*.db
*.sqlite
*.sqlite3
FOREST.db
FOREST_backup.db
app/backend/data/*
!app/backend/data/.gitkeep
!app/backend/snapshot/

# Uploads & Media Artifacts
app/backend/uploads/*
!app/backend/uploads/.gitkeep
!app/backend/snapshot/uploads/
uploads/
Videos/
*.mp4
*.mov
*.avi
*.webm

# Temporary & Cache
tmp/
temp/
*.log
.cache/
coverage/
